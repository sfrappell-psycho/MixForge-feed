{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sfrappell-psycho/MixForge-feed/main/feed.schema.json",
  "title": "MixForge feed",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "hot", "viral", "methods", "news", "releases", "suggestions"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "$ref": "#/$defs/date" },
    "hot": { "type": "array", "items": { "$ref": "#/$defs/video" } },
    "viral": { "type": "array", "items": { "$ref": "#/$defs/video" } },
    "methods": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/video" }, { "$ref": "#/$defs/tip" }] } },
    "news": { "type": "array", "items": { "$ref": "#/$defs/news" } },
    "releases": { "type": "array", "items": { "$ref": "#/$defs/release" } },
    "suggestions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artists", "genres"],
      "properties": {
        "artists": { "type": "array", "items": { "type": "string" } },
        "genres": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\d{4}-\d{2}-\d{2}$" },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "channel", "published", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
        "title": { "type": "string" },
        "channel": { "type": "string" },
        "published": { "$ref": "#/$defs/date" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "tip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "tip"],
      "properties": { "title": { "type": "string" }, "tip": { "type": "string" } }
    },
    "news": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "date"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "date": { "$ref": "#/$defs/date" },
        "url": { "type": "string" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "title", "notes"],
      "properties": {
        "version": { "type": "string", "pattern": "^\d+\.\d+\.\d+$" },
        "title": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
